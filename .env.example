# Database credentials used by the application
DB_HOST=database
DB_PORT=27017
DB_USER=ethosAdmin
DB_PASSWORD=1234
DB_NAME=ethosIA

# anthropic | openai | openrouter | gemini | nous | upstage | mistral | groq | deepseek | xai | together | fireworks | perplexity | cerebras | huggingface | ollama | lmstudio | openai-compatible
LLM_PROVIDER=anthropic
# Every LLM_* below works with any provider; leave it empty to use the provider's default (anthropic)
LLM_MODEL=
# Falls back to the provider's own variable (ANTHROPIC_API_KEY, OPENAI_API_KEY, ...). Not needed for ollama / lmstudio.
LLM_API_KEY=
# The provider's API endpoint. Required for every provider except anthropic and openai (their SDKs know it);
# set it for those too to go through a proxy or gateway.
#   openai       https://api.openai.com/v1
#   openrouter   https://openrouter.ai/api/v1
#   gemini       https://generativelanguage.googleapis.com/v1beta/openai/
#   nous         https://inference-api.nousresearch.com/v1
#   upstage      https://api.upstage.ai/v1
#   mistral      https://api.mistral.ai/v1
#   groq         https://api.groq.com/openai/v1
#   deepseek     https://api.deepseek.com/v1
#   xai          https://api.x.ai/v1
#   together     https://api.together.xyz/v1
#   fireworks    https://api.fireworks.ai/inference/v1
#   perplexity   https://api.perplexity.ai
#   cerebras     https://api.cerebras.ai/v1
#   huggingface  https://router.huggingface.co/v1
#   ollama       http://localhost:11434/v1  (from a container: http://host.containers.internal:11434/v1)
#   lmstudio     http://localhost:1234/v1   (from a container: http://host.containers.internal:1234/v1)
LLM_BASE_URL=
# Maximum tokens per reply
LLM_MAX_TOKENS=16000
# Reasoning effort, only for models that support it. anthropic: low | medium | high | xhigh | max (default low);
# OpenAI-style providers: minimal | low | medium | high (default: not sent)
LLM_EFFORT=

# Number of past messages the assistant remembers per conversation
MEMORY_WINDOW=50

DJANGO_SECRET_KEY=change-me

API_TARGET=
